    {
      "id": "no-auth",
      "domain": "filesystem",
      "simulated_t_safe": false,
      "forbidden": true,
      "token": null,
      "tool_call": {
        "method": "tools/call",
        "params": { "name": "fs:read_file", "arguments": { "path": "/etc/passwd" } }
      },
      "notes": "Unauthenticated; gateway should 401 before policy."
