{
  "name": "federated-mcp-control-plane",
  "version": "0.1.0",
  "description": "Federated MCP control plane with tools/list aggregation and ABAC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/run-all.ts",
    "bench:latency": "tsx bench/latency.ts",
    "bench:throughput": "tsx bench/throughput.ts",
    "bench:policy": "tsx bench/policy-overhead.ts",
    "example:demo": "tsx examples/demo-client.ts",
    "eval:gap": "tsx eval/gap/harness.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "hono": "^4.7.10",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
